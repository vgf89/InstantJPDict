<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- #72: opt out of predictive back. Targeting SDK 35 enables it by default,
         which routes back through the focused window's OnBackInvokedDispatcher.
         An accessibility overlay window never gets that callback (see
         OcrAccessibilityService.registerBackCallback), so back died on our
         window. Opting out restores legacy KEYCODE_BACK dispatch, which this
         service's key filtering does receive. -->
    <application
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InstantJPDict">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.InstantJPDict">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- #57 (Feat — image share intent): a single shared image goes through
             the same OCR/lookup surface as the accessibility overlay. Only
             ACTION_SEND is handled; ACTION_SEND_MULTIPLE is a later follow-up. -->
        <activity
            android:name=".ShareImageActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.InstantJPDict.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".OcrAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>